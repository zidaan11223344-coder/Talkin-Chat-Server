# Central Talkin account that receives S-Boot commands in private chat.
SERVER_BOT_ID=-sbot-
SERVER_BOT_PASSWORD=

# Leave blank to generate once at first startup and persist under BOT_SERVER_DATA_DIR.
# Use a writable persistent path and never delete its key file.
STATE_ENCRYPTION_KEY=
# Project-local data folder: ./data (Docker/Railway volume alternative: /data).
# This is a filesystem path, not a bot access token.
BOT_SERVER_DATA_DIR=./data
PORT=8080

# Text used on the coloured controller/silent child profiles.
SERVER_ADMIN_NAME=ۦاݪــۛـسـ𓆩♛𓆪ـۧۦـ۫ـفـيــ۫ـۧ𝁤𝆬𝃛

# Poll Talkin's native incoming friend-request list over the account WebSocket.
FRIEND_POLL_SECONDS=10

# Optional: override the default public GitHub raw path for the cricket images.
# CRICKET_ASSET_BASE_URL=https://raw.githubusercontent.com/zidaan11223344-coder/Talkin-Chat-Server/main/vendor/assets

# Optional Talkin transport overrides when the default chatp.net route changes.
API_BASE_URL=https://chatp.net/api?
HOST_HEADER=chatp.net
WS_HOSTS=chatp.net
SOCKET_PORT=5335
WS_PATHS=/server

# Cricket reward pool; split equally among players on the winning team.
CRICKET_PRIZE=200000
