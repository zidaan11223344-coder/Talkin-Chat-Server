# Central Talkin account that receives S-Boot commands in private chat.
SERVER_BOT_ID=-sbot-
SERVER_BOT_PASSWORD=

# Generate once and keep it unchanged on the persistent host:
# python -c "from state import CredentialVault; print(CredentialVault.generate())"
STATE_ENCRYPTION_KEY=
BOT_SERVER_DATA_DIR=/data
PORT=8080

# Text used on the coloured controller/silent child profiles.
SERVER_ADMIN_NAME=ۦاݪــۛـسـ𓆩♛𓆪ـۧۦـ۫ـفـيــ۫ـۧ𝁤𝆬𝃛

# Needed for automatic friendship acceptance and the complete room-settings roster.
# Give this service account the database/RLS permissions to read profiles and
# room_members and update only pending friendships addressed to SERVER_BOT_ID.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_EMAIL=
SUPABASE_PASSWORD=
FRIEND_POLL_SECONDS=1

# Optional Talkin transport overrides when the default chatp.net route changes.
API_BASE_URL=https://chatp.net/api?
HOST_HEADER=chatp.net
WS_HOSTS=chatp.net
SOCKET_PORT=5335
WS_PATHS=/server
